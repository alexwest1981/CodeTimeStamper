{
  "name": "codetimestamper",
  "displayName": "CodeTimeStamper",
  "description": "Tidstämplar aktiv kodtid per dag. Inget annat.",
  "version": "0.1.4",
  "publisher": "alexwest",
  "license": "MIT",
  "author": {
    "name": "Alex"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexwest1981/CodeTimeStamper.git"
  },
  "bugs": {
    "url": "https://github.com/alexwest1981/CodeTimeStamper/issues"
  },
  "homepage": "https://github.com/alexwest1981/CodeTimeStamper#readme",
  "keywords": [
    "time tracking",
    "productivity",
    "activity",
    "idle",
    "privacy",
    "stats"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codetimestamper.show",
        "title": "CodeTimeStamper: Visa rapport"
      },
      {
        "command": "codetimestamper.openFolder",
        "title": "CodeTimeStamper: Öppna rapportmappen"
      }
    ],
    "configuration": {
      "title": "CodeTimeStamper",
      "properties": {
        "codetimestamper.idleMinutes": {
          "type": "number",
          "default": 10,
          "description": "Minuter utan aktivitet innan timern pausar."
        },
        "codetimestamper.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Stäng av mätningen helt utan att avinstallera."
        },
        "codetimestamper.recordProject": {
          "type": "boolean",
          "default": true,
          "description": "Spara projektmappens namn (bara namnet, aldrig sökvägen) så rapporten kan visa vilket projekt tiden gick till. Av = bara tidsstämplar och editorns namn."
        }
      }
    }
  },
  "scripts": {
    "test": "TZ=Europe/Stockholm node test/test.js && TZ=Europe/Stockholm node test/extension-harness.js",
    "package": "npx --yes @vscode/vsce package --out codetimestamper.vsix"
  }
}
